// Time Complexity O(n)

public class LinearSearch {

    public static void main(String[] args) {

        int[] arr = {4, 9, 2, 8, 5};
        
        int target = 8;

        boolean found = false;

        for(int num : arr) {

            if(num == target) {
                found = true;
                break;
            }
        }

        System.out.println(found);

    }
}